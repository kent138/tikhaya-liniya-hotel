{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/rooms/standard",
      "destination": "/rooms/standard/index.html"
    },
    {
      "source": "/rooms/comfort",
      "destination": "/rooms/comfort/index.html"
    },
    {
      "source": "/rooms/deluxe",
      "destination": "/rooms/deluxe/index.html"
    },
    {
      "source": "/rooms/suite",
      "destination": "/rooms/suite/index.html"
    },
    {
      "source": "/booking",
      "destination": "/booking/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/|images/|assets/|favicon.svg|robots.txt|sitemap.xml).*)",
      "destination": "/fallback/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
